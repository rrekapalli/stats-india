# Stats India workspace secrets and deployment constants.
# Copy to .env and fill in real values (.env is gitignored).

# --- Proxmox (remote deploy from dev machine) ---
PROXMOX_HOST=192.168.29.231
PROXMOX_USER=root
PROXMOX_PASSWORD=CHANGEME

# --- LXC container login (stats-india VMID 7001) ---
CONTAINER_USER=raja
CONTAINER_PASSWORD=CHANGEME

# --- Tailscale (optional; auto-join on deploy) ---
# Pre-auth key: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TAILNET_DNS=tailce422e.ts.net
# Optional Admin API key to dedupe hostname before join (tskey-api-...)
TAILSCALE_API_KEY=

# --- SSH (optional; manual access to container) ---
SSH_USER=raja
SSH_PASSWORD=

# --- Application (Spring Boot) ---
SPRING_PROFILES_ACTIVE=prod
STATS_INDIA_JAVA_OPTS="-Xms256m -Xmx768m"

# --- Public hostname (MagicDNS); override if different tailnet ---
STATS_INDIA_HOST=stats-india.tailce422e.ts.net

# --- PostgreSQL (pg18 shared with moneytree tailnet) ---
DB_HOST=pg18.tailce422e.ts.net
DB_PORT=6432
DB_NAME=stats-india
DB_USERNAME=stats_india
DB_PASSWORD=CHANGEME
DATABASE_URL=jdbc:postgresql://pg18.tailce422e.ts.net:6432/stats-india

# --- data.gov.in API (https://data.gov.in/catalog) ---
# Register at https://data.gov.in/user/register to obtain an API key
DATA_GOV_IN_API_KEY=
