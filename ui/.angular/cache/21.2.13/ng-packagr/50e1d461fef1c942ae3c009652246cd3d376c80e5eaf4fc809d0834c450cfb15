is.seriesOptions.itemStyle.color = colors;\n        return this;\n    }\n    /**\n     * Set emphasis focus\n     */\n    setEmphasisFocus(focus) {\n        if (!this.seriesOptions.emphasis)\n            this.seriesOptions.emphasis = {};\n        this.seriesOptions.emphasis.focus = focus;\n        return this;\n    }\n    /**\n     * Build the widget\n     */\n    build() {\n        return super.build();\n    }\n    /**\n     * Static method to update data in an existing widget with enhanced retry mechanism\n     */\n    static updateData(widget, data, retryOptions) {\n        if (widget.config?.options?.series?.[0]) {\n            widget.config.options.series[0].data = data.nodes;\n            widget.config.options.series[0].links = data.links;\n        }\n        widget.data = data;\n        D3ChartBuilder.updateData(widget, data, retryOptions);\n    }\n    /**\n     * Transform generic data array to sankey format\n     */\n    static transformToSankeyData(data, options) {\n        if (!data || data.length === 0)\n            return { nodes: [], links: [] };\n        const sourceField = options?.sourceField || 'source';\n        const targetField = options?.targetField || 'target';\n        const valueField = options?.valueField || 'value';\n        const aggregateBy = options?.aggregateBy || 'sum';\n        // Extract unique nodes\n        const nodeSet = new Set();\n        data.forEach(item => {\n            nodeSet.add(String(item[sourceField]));\n            nodeSet.add(String(item[targetField]));\n        });\n        const nodes = Array.from(nodeSet).map(name => ({ name }));\n        // Transform links and aggregate if needed\n        const linkMap = new Map();\n        data.forEach(item => {\n            const source = String(item[sourceField]);\n            const target = String(item[targetField]);\n            const value = Number(item[valueField]) || 1;\n            const key = `${source}->${target}`;\n            if (linkMap.has(key)) {\n              