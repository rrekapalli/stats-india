 origin: 'auto',\n        };\n        return this;\n    }\n    /**\n     * Set gradient area style\n     */\n    setGradientAreaStyle(startColor, endColor, opacity = 0.6) {\n        this.seriesOptions.areaStyle = {\n            color: {\n                type: 'linear',\n                x: 0,\n                y: 0,\n                x2: 0,\n                y2: 1,\n                colorStops: [\n                    { offset: 0, color: startColor },\n                    { offset: 1, color: endColor }\n                ],\n            },\n            opacity,\n            origin: 'auto',\n        };\n        return this;\n    }\n    /**\n     * Set show symbol\n     */\n    setShowSymbol(show) {\n        this.seriesOptions.showSymbol = show;\n        return this;\n    }\n    /**\n     * Set stack for stacked area charts\n     */\n    setStack(stack) {\n        this.seriesOptions.stack = stack;\n        return this;\n    }\n    /**\n     * Set sampling method for large datasets\n     */\n    setSampling(sampling) {\n        this.seriesOptions.sampling = sampling;\n        return this;\n    }\n    /**\n     * Set colors for multiple series\n     */\n    setColors(colors) {\n        this.colors = colors;\n        return this;\n    }\n    /**\n     * Set predefined color palette\n     */\n    setPredefinedPalette(palette) {\n        const colors = this.getPaletteColors(palette);\n        if (colors.length > 0) {\n            this.setColors(colors);\n        }\n        return this;\n    }\n    /**\n     * Set currency formatter for values\n     */\n    setCurrencyFormatter(currency = 'USD', locale = 'en-US') {\n        const formatter = this.createCurrencyFormatter(currency, locale);\n        this.setTooltip('axis', (params) => {\n            if (!Array.isArray(params))\n                return '';\n            let result = `${params[0].name}<br/>`;\n            params.forEach((param) => {\n                result += `${param.seriesName}: ${formatter(param.value)}<br/>`;\n            });\n            return result;\n        });\n        return this;\n    }\n    /**\n     * Set percentage formatter for values\n     */\n    setPercentageFormatter(decimals = 1) {\n        const formatter = this.createPercentageFormatter(decimals);\n        this.setTooltip('axis', (params) => {\n            if (!Array.isArray(params))\n                return '';\n            let result = `${params[0].name}<br/>`;\n            params.forEach((param) => {\n                result += `${param.seriesName}: ${formatter(param.value)}<br/>`;\n            });\n            return result;\n        });\n        return this;\n    }\n    /**\n     * Set number formatter for values with custom options\n     */\n    setCustomNumberFormatter(decimals = 0, locale = 'en-US') {\n        const formatter = this.createNumberFormatter(decimals, locale);\n        this.setTooltip('axis', (params) => {\n            if (!Array.isArray(params))\n                return '';\n            let result = `${params[0].name}<br/>`;\n            params.forEach((param) => {\n                result += `${param.seriesName}: ${formatter(param.value)}<br/>`;\n            });\n            return result;\n        });\n        return this;\n    }\n    /**\n     * Set filter column for filtering integration\n     */\n    setFilterColumn(column) {\n        this.filterColumn = column;\n        return this;\n    }\n    /**\n     * Create filter from chart data\n     */\n    createFilterFromChartData() {\n        if (!this.filterColumn || !this.data)\n            return [];\n        const uniqueValues = [...new Set(this.data.map(item => item[this.filterColumn]))];\n        return [{\n                column: this.filterColumn,\n                operator: 'in',\n                value: uniqueValues\n            }];\n    }\n    /**\n     * Generate sample data for testing\n     */\n    generateSampleData(seriesCount = 3, categoryCount = 7) {\n        const sampleData = [];\n        const seriesNames = ['Revenue', 'Expenses', 'Profit', 'Investment', 'Savings'].slice(0, seriesCount);\n        const categories = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'].slice(0, categoryCount);\n        for (const series of seriesNames) {\n            const data = [];\n            for (let i = 0; i < categoryCount; i++) {\n                data.push(Math.floor(Math.random() * 200) + 50);\n            }\n            sampleData.push({\n                name: series,\n                data,\n                category: ['Primary', 'Secondary', 'Tertiary'][Math.floor(Math.random() * 3)]\n            });\n        }\n        this.setMultiSeriesData(sampleData);\n        this.setXAxisData(categories);\n        return this;\n    }\n    /**\n     * Configuration preset for financial analysis\n     */\n    setFinancialAnalysisConfiguration() {\n        return this\n            .setPredefinedPalette('finance')\n            .setCurrencyFormatter('USD', 'en-US')\n            .setXAxisName('Time Period')\n            .setYAxisName('Amount')\n            .setStack('financial')\n            .setSmooth(true);\n    }\n    /**\n     * Configuration preset for performance monitoring\n     */\n    setPerformanceMonitoringConfiguration() {\n        return this\n            .setPredefinedPalette('business')\n            .setPercentageFormatter(1)\n            .setXAxisName('Metrics')\n            .setYAxisName('Performance')\n            .setStack('performance')\n            .setAreaStyle('#5470c6', 0.5);\n    }\n    /**\n     * Configuration preset for trend analysis\n     */\n    setTrendAnalysisConfiguration() {\n        return this\n            .setPredefinedPalette('modern')\n            .setCustomNumberFormatter(0, 'en-US')\n            .setXAxisName('Period')\n            .setYAxisName('Value')\n            .setStack('trend')\n            .setSmooth(false)\n            .setSymbol('circle', 4);\n    }\n    /**\n     * Build the widget with stacked area chart configuration\n     */\n    build() {\n        // Create series from multi-series data\n        const series = [];\n        if (this.multiSeriesData.length > 0) {\n            this.multiSeriesData.forEach((seriesData, index) => {\n                const seriesOption = {\n                    ...this.seriesOptions,\n                    name: seriesData.name,\n                    data: seriesData.data,\n                    itemStyle: {\n                        color: this.colors[index % this.colors.length],\n                    },\n                    areaStyle: {\n                        color: this.colors[index % this.colors.length],\n                        opacity: 0.6,\n                        origin: 'auto',\n                    },\n                    lineStyle: {\n                        width: 2,\n                        color: this.colors[index % this.colors.length],\n                        type: 'solid',\n                    },\n                };\n                series.push(seriesOption);\n            });\n        }\n        else {\n            // Fallback to single series\n            series.push(this.seriesOptions);\n        }\n        // Set the series\n        this.chartOptions.series = series;\n        // Set the chart options\n        this.widgetBuilder.setEChartsOptions(this.chartOptions);\n        return this.widgetBuilder.build();\n    }\n    /**\n     * Enhanced updateData with retry mechanism\n     */\n    static updateData(widget, data) {\n        const maxRetries = 3;\n        let retryCount = 0;\n        const updateWithRetry = () => {\n            try {\n                if (widget.chartInstance) {\n                    // Transform data if needed\n                    let transformedData = data;\n                    if (Array.isArray(data) && data.length > 0 && typeof data[0] === 'object') {\n                        transformedData = data.map(series => ({\n                            name: series.name || 'Series',\n                            data: series.data || [],\n                            type: 'line',\n                            stack: 'total',\n                            areaStyle: {}\n                        }));\n                    }\n                    const currentOptions = widget.chartInstance.getOption();\n                    const newOptions = {\n                        ...currentOptions,\n                        series: transformedData\n                    };\n                    widget.chartInstance.setOption(newOptions, true);\n                }\n                else if (retryCount < maxRetries) {\n                    retryCount++;\n                    setTimeout(updateWithRetry, 100 * retryCount);\n                }\n            }\n            catch (error) {\n                console.error('Error updating stacked area chart data:', error);\n                if (retryCount < maxRetries) {\n                    retryCount++;\n                    setTimeout(updateWithRetry, 100 * retryCount);\n                }\n            }\n        };\n        updateWithRetry();\n    }\n    /**\n     * Check if widget is a stacked area chart\n     */\n    static isStackedAreaChart(widget) {\n        const options = widget.config?.options;\n        return options?.series?.[0]?.type === 'line' &&\n            options?.series?.[0]?.areaStyle &&\n            options?.series?.[0]?.stack;\n    }\n    /**\n     * Create stacked area chart widget with default configuration\n     */\n    static createStackedAreaChartWidget(data, xAxisData) {\n        const colors = ['#5470c6', '#91cc75', '#fac858', '#ee6666', '#73c0de', '#3ba272', '#fc8452', '#9a60b4'];\n        const series = [];\n        if (data && data.length > 0) {\n            data.forEach((seriesData, index) => {\n                series.push({\n                    name: seriesData.name,\n                    type: 'line',\n                    data: seriesData.data,\n                    smooth: false,\n                    symbol: 'circle',\n                    symbolSize: 6,\n                    showSymbol: true,\n                    lineStyle: {\n                        width: 2,\n                        color: colors[index % colors.length],\n                        type: 'solid',\n                    },\n                    itemStyle: {\n                        color: colors[index % colors.length],\n                    },\n                    areaStyle: {\n                        color: colors[index % colors.length],\n                        opacity: 0.6,\n                        origin: 'auto',\n                    },\n                    stack: 'total',\n                    emphasis: {\n                        focus: 'series',\n                        itemStyle: {\n                            shadowBlur: 10,\n                            shadowOffsetX: 0,\n                            shadowColor: 'rgba(0, 0, 0, 0.5)',\n                        },\n                    },\n                });\n            });\n        }\n        const builder = new WidgetBuilder()\n            .setComponent('echart')\n            .setEChartsOptions({\n            grid: {\n                containLabel: true,\n                top: '15%',\n                left: '10%',\n                right: '10%',\n                bottom: '15%',\n            },\n            tooltip: {\n                trigger: 'axis',\n                formatter: '{b}: {c}',\n            },\n            legend: {\n                show: true,\n                orient: 'horizontal',\n                left: 'center',\n                bottom: '10',\n            },\n            xAxis: {\n                type: 'category',\n                data: xAxisData || [],\n                nameLocation: 'middle',\n                axisLabel: {\n                    rotate: 0,\n                    color: '#666',\n                },\n            },\n            yAxis: {\n                type: 'value',\n                nameLocation: 'middle',\n                axisLabel: {\n                    color: '#666',\n                },\n            },\n            series: series,\n        });\n        return builder;\n    }\n    /**\n     * Export data from stacked area chart widget\n     */\n    static exportData(widget) {\n        if (!StackedAreaChartBuilder.isStackedAreaChart(widget)) {\n            return [];\n        }\n        const options = widget.config?.options;\n        const series = options?.series;\n        const xAxis = options?.xAxis;\n        if (!series || series.length === 0)\n            return [];\n        // Handle different xAxis structures\n        let categories = [];\n        if (xAxis) {\n            if (Array.isArray(xAxis)) {\n                categories = xAxis[0]?.data || [];\n            }\n            else if (xAxis.data) {\n                categories = xAxis.data;\n            }\n        }\n        // If no categories found, create default ones\n        if (categories.length === 0 && series[0]?.data) {\n            categories = series[0].data.map((_, index) => `Point ${index + 1}`);\n        }\n        const data = [];\n        series.forEach((s, index) => {\n            if (s.data) {\n                s.data.forEach((value, pointIndex) => {\n                    if (index === 0) {\n                        data[pointIndex] = [categories[pointIndex] || `Point ${pointIndex + 1}`];\n                    }\n                    if (data[pointIndex]) {\n                        data[pointIndex].push(value || 0);\n                    }\n                });\n            }\n        });\n        return data;\n    }\n    /**\n     * Get export headers for stacked area chart\n     */\n    static getExportHeaders(widget) {\n        const options = widget.config?.options;\n        const series = options?.series;\n        if (!series || series.length === 0)\n            return ['Category'];\n        return ['Category', ...series.map((s) => s.name || 'Series')];\n    }\n    /**\n     * Get export sheet name for stacked area chart\n     */\n    static getExportSheetName(widget) {\n        const title = widget.config?.header?.title || 'Stacked Area Chart';\n        return `StackedAreaChart_${title.replace(/[^a-zA-Z0-9]/g, '_')}`;\n    }\n}\n/**\n * Factory function to create stacked area chart widget\n */\nfunction createStackedAreaChartWidget(data, xAxisData) {\n    return StackedAreaChartBuilder.createStackedAreaChartWidget(data, xAxisData);\n}\n\n// Stacked Area Chart Builder exports\n\n/**\n * Treemap Chart Builder extending the generic ApacheEchartBuilder\n *\n * Usage examples:\n *\n * // Basic usage with default options\n * const widget = TreemapChartBuilder.create()\n *   .setData(initialData)\n *   .setHeader('Portfolio Distribution')\n *   .setPosition({ x: 0, y: 0, cols: 4, rows: 4 })\n *   .build();\n *\n * // Advanced usage with custom options\n * const widget = TreemapChartBuilder.create()\n *   .setData(initialData)\n *   .setTitle('Investment Portfolio', 'By Asset Class and Sector')\n *   .setBreadcrumb(true, 'top', 'left', 'right', 'bottom')\n *   .setItemStyle('#fff', 1, 1)\n *   .setLabelFormatter('{b}: {c}')\n *   .setLevels([\n *     {\n *       itemStyle: { borderColor: '#777', borderWidth: 0, gapWidth: 1 },\n *       label: { show: false }\n *     },\n *     {\n *       itemStyle: { borderColor: '#555', borderWidth: 5, gapWidth: 1 },\n *       label: { show: true }\n *     }\n *   ])\n *   .setEmphasis(10, 0, 'rgba(0, 0, 0, 0.5)')\n *   .setRoam(true)\n *   .setNodeClick('zoomToNode')\n *   .setTooltip('item', '{b}: {c}')\n *   .setHeader('Investment Portfolio')\n *   .setPosition({ x: 0, y: 0, cols: 6, rows: 4 })\n *   .build();\n *\n * // Update widget data dynamically\n * TreemapChartBuilder.updateData(widget, newData);\n */\nclass TreemapChartBuilder extends ApacheEchartBuilder {\n    filterColumn;\n    constructor() {\n        super();\n        this.seriesOptions = this.getDefaultSeriesOptions();\n    }\n    /**\n     * Create a new TreemapChartBuilder instance\n     */\n    static create() {\n        return new TreemapChartBuilder();\n    }\n    /**\n     * Implement abstract method to get default options\n     */\n    getDefaultOptions() {\n        return {\n            tooltip: {\n                trigger: 'item',\n                formatter: '{b}: {c}',\n            },\n            series: [],\n        };\n    }\n    /**\n     * Implement abstract method to get chart type\n     */\n    getChartType() {\n        return 'treemap';\n    }\n    /**\n     * Get default series options for treemap chart\n     */\n    getDefaultSeriesOptions() {\n        return {\n            name: 'Treemap Chart',\n            type: 'treemap',\n            top: '13%',\n            left: '2%',\n            right: '2%',\n            bottom: '5%',\n            breadcrumb: {\n                show: true,\n                top: '5%',\n                left: '2%',\n                right: '2%',\n                height: 22,\n            },\n            itemStyle: {\n                borderColor: '#fff',\n                borderWidth: 1,\n                gapWidth: 1,\n            },\n            label: {\n                show: true,\n                formatter: '{b}',\n                fontSize: 12,\n                color: '#333',\n            },\n            levels: [\n                {\n                    itemStyle: {\n                        borderColor: '#777',\n                        borderWidth: 1,\n                        gapWidth: 1,\n                    },\n                    label: {\n                        show: false,\n                    },\n                },\n                {\n                    itemStyle: {\n                        borderColor: '#555',\n                        borderWidth: 1,\n                        gapWidth: 1,\n                    },\n                    label: {\n                        show: true,\n                    },\n                },\n                {\n                    itemStyle: {\n                        borderColor: '#555',\n                        borderWidth: 1,\n                        gapWidth: 1,\n                    },\n                    label: {\n                        show: true,\n                    },\n                },\n            ],\n            emphasis: {\n                itemStyle: {\n                    shadowBlur: 3,\n                    shadowOffsetX: 0,\n                    shadowColor: 'rgba(0, 0, 0, 0.5)',\n                },\n            },\n            roam: true,\n            nodeClick: 'zoomToNode',\n        };\n    }\n    /**\n     * Set the data for the treemap chart\n     */\n    setData(data) {\n        this.seriesOptions.data = data;\n        super.setData(data);\n        return this;\n    }\n    /**\n     * Set breadcrumb configuration with enhanced styling\n     */\n    setBreadcrumb(show, top, left, right, bottom) {\n        this.seriesOptions.breadcrumb = {\n            show,\n            top,\n            left,\n            right,\n            bottom,\n            height: 22,\n            emptyItemWidth: 25,\n            itemStyle: {\n                color: 'rgba(0,0,0,0.7)',\n                borderColor: 'rgba(0,0,0,0.7)',\n                borderWidth: 1,\n                shadowBlur: 3,\n                shadowColor: 'rgba(0, 0, 0, 0.2)',\n                textStyle: {\n                    color: '#fff'\n                }\n            },\n            emphasis: {\n                itemStyle: {\n                    color: 'rgba(0,0,0,0.9)'\n                }\n            }\n        };\n        return this;\n    }\n    /**\n     * Set item style for treemap\n     */\n    setItemStyle(borderColor, borderWidth, gapWidth) {\n        this.seriesOptions.itemStyle = {\n            borderColor,\n            borderWidth,\n            gapWidth,\n        };\n        return this;\n    }\n    /**\n     * Set label formatter for treemap\n     */\n    setLabelFormatter(formatter) {\n        if (!this.seriesOptions.label)\n            this.seriesOptions.label = {};\n        this.seriesOptions.label.formatter = formatter;\n        return this;\n    }\n    /**\n     * Set levels configuration for treemap\n     */\n    setLevels(levels) {\n        this.seriesOptions.levels = levels;\n        return this;\n    }\n    /**\n     * Set roam option for treemap\n     */\n    setRoam(roam) {\n        this.seriesOptions.roam = roam;\n        return this;\n    }\n    /**\n     * Set node click behavior\n     */\n    setNodeClick(nodeClick) {\n        this.seriesOptions.nodeClick = nodeClick;\n        return this;\n    }\n    /**\n     * Treemap: ECharts often omits series params on `chart.on('dblclick')`. Use zrender `dblclick`\n     * plus `TreemapView.findTarget` (via `getViewOfSeriesModel`) for reliable hit-testing.\n     */\n    setStockNavigationEvents(navigationCallback, symbolField = 'tradingsymbol', preferredEvent = 'dblclick') {\n        if (preferredEvent !== 'dblclick') {\n            return super.setStockNavigationEvents(navigationCallback, symbolField, preferredEvent);\n        }\n        const resolveFromParams = (params) => {\n            const d = params?.data;\n            if (d && typeof d === 'object' && !Array.isArray(d)) {\n                const sym = d[symbolField] ?? d.symbol ?? d.tradingsymbol;\n                if (typeof sym === 'string' && sym.trim()) {\n                    return sym.trim();\n                }\n            }\n            if (Array.isArray(params?.treePathInfo) && params.treePathInfo.length > 0) {\n                for (let i = params.treePathInfo.length - 1; i >= 0; i--) {\n                    const nm = params.treePathInfo[i]?.name;\n                    if (typeof nm !== 'string' || !nm.trim()) {\n                        continue;\n                    }\n                    if (nm.includes('·')) {\n                        return nm.split('·')[0].trim();\n                    }\n                    if (nm !== 'Treemap Chart') {\n                        return nm.trim();\n                    }\n                }\n            }\n            if (typeof params?.name === 'string' && params.name.includes('·')) {\n                return params.name.split('·')[0].trim();\n            }\n            return undefined;\n        };\n        const resolveFromTreeNode = (seriesModel, node) => {\n            if (!node || node.dataIndex == null) {\n                return undefined;\n            }\n            const data = seriesModel.getData();\n            const item = data.getRawDataItem(node.dataIndex);\n            if (item && typeof item === 'object') {\n                const v = item[symbolField] ?? item['tradingsymbol'] ?? item['symbol'];\n                if (typeof v === 'string' && v.trim()) {\n                    return v.trim();\n                }\n                const n = item['name'];\n                if (typeof n === 'string' && n.includes('·')) {\n                    return n.split('·')[0].trim();\n                }\n                if (typeof n === 'string' && n.trim()) {\n                    return n.trim();\n                }\n            }\n            return undefined;\n        };\n        this.widgetBuilder.setEvents((widget, chart) => {\n            if (!chart) {\n                return;\n            }\n            let lastNavAt = 0;\n            const safeNav = (sym) => {\n                const s = (sym || '').trim();\n                if (!s) {\n                    return;\n                }\n                const t = Date.now();\n                if (t - lastNavAt < 450) {\n                    return;\n                }\n                lastNavAt = t;\n                navigationCallback(s);\n            };\n            const pickOffsets = (ze) => {\n                if (!ze) {\n                    return { offsetX: 0, offsetY: 0 };\n                }\n                const zx = ze.zrX ?? ze.x;\n                const zy = ze.zrY ?? ze.y;\n                if (typeof zx === 'number' && typeof zy === 'number' && !Number.isNaN(zx) && !Number.isNaN(zy)) {\n                    return { offsetX: zx, offsetY: zy };\n                }\n                if (typeof ze.offsetX === 'number' && typeof ze.offsetY === 'number') {\n                    return { offsetX: ze.offsetX, offsetY: ze.offsetY };\n                }\n                const ev = ze.event;\n                if (ev && typeof ev.offsetX === 'number' && typeof ev.offsetY === 'number') {\n                    return { offsetX: ev.offsetX, offsetY: ev.offsetY };\n                }\n                return { offsetX: 0, offsetY: 0 };\n            };\n            const tryHitTiles = (e) => {\n                const opt = chart.getOption();\n                if (!opt?.series?.length || opt.series[0].type !== 'treemap') {\n                    return;\n                }\n                const ecModel = chart.getModel();\n                const byType = ecModel.getSeriesByType?.('treemap');\n                const seriesModel = (Array.isArray(byType) && byType[0]) || ecModel.getSeriesByIndex(0);\n                if (!seriesModel) {\n                    return;\n                }\n                const view = chart.getViewOfSeriesModel(seriesModel);\n                if (!view || typeof view.findTarget !== 'function') {\n                    return;\n                }\n                const targetInfo = view.findTarget(e.offsetX, e.offsetY);\n                const node = targetInfo?.node;\n                if (!node) {\n                    return;\n                }\n                safeNav(resolveFromTreeNode(seriesModel, node));\n            };\n            const chartHandler = (params) => {\n                const wopt = widget?.config?.options;\n                if (wopt?.series?.[0]?.type !== 'treemap') {\n                    return;\n                }\n                const looksTreemap = params?.seriesType === 'treemap' ||\n                    params?.componentSubType === 'treemap' ||\n                    (params?.componentType === 'series' &&\n                        (params?.dataIndex != nul