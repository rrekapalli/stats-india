s.layout = layout;\n        return this;\n    }\n    /**\n     * Set line curveness\n     */\n    setCurveness(curveness) {\n        if (!this.seriesOptions.lineStyle)\n            this.seriesOptions.lineStyle = {};\n        this.seriesOptions.lineStyle.curveness = curveness;\n        return this;\n    }\n    /**\n     * Set line color\n     */\n    setLineColor(color) {\n        if (!this.seriesOptions.lineStyle)\n            this.seriesOptions.lineStyle = {};\n        this.seriesOptions.lineStyle.color = color;\n        return this;\n    }\n    /**\n     * Set node colors\n     */\n    setNodeColors(colors) {\n        if (!this.seriesOptions.itemStyle)\n            this.seriesOptions.itemStyle = {};\n        this.seriesOptions.itemStyle.color = colors;\n        return this;\n    }\n    /**\n     * Set emphasis focus\n     */\n    setEmphasisFocus(focus) {\n        if (!this.seriesOptions.emphasis)\n            this.seriesOptions.emphasis = {};\n        this.seriesOptions.emphasis.focus = focus;\n        return this;\n    }\n    /**\n     * Build the widget\n     */\n    build() {\n        // Merge series options with chart options, splitting nodes/links\n        let nodes = this.seriesOptions.data?.nodes;\n        let links = this.seriesOptions.data?.links;\n        const finalOptions = {\n            ...this.chartOptions,\n            series: [{\n                    ...this.seriesOptions,\n                    type: 'sankey',\n                    data: nodes,\n                    links: links,\n                }],\n        };\n        return this.widgetBuilder\n            .setEChartsOptions(finalOptions)\n            .build();\n    }\n    /**\n     * Static method to update data in an existing widget with enhanced retry mechanism\n     */\n    static updateData(widget, data, retryOptions) {\n        if (widget.config?.options?.series?.[0]) {\n            widget.config.options.series[0].data = data.nodes;\n            widget.config.options.series[0].links = data.links;\n        }\n        widget.data = data;\n        ApacheEchartBuilder.updateData(widget, data, retryOptions);\n    }\n    /**\n     * Transform generic data array to sankey format\n     */\n    static transformToSankeyData(data, options) {\n        if (!data || data.length === 0)\n            return { nodes: [], links: [] };\n        const sourceField = options?.sourceField || 'source';\n        const targetField = options?.targetField || 'target';\n        const valueField = options?.valueField || 'value';\n        const aggregateBy = options?.aggregateBy || 'sum';\n        // Extract unique nodes\n        const nodeSet = new Set();\n        data.forEach(item => {\n            nodeSet.add(String(item[sourceField]));\n            nodeSet.add(String(item[targetField]));\n        });\n        const nodes = Array.from(nodeSet).map(name => ({ name }));\n        // Transform links and aggregate if needed\n        const linkMap = new Map();\n        data.forEach(item => {\n            const source = String(item[sourceField]);\n            const target = String(item[targetField]);\n            const value = Number(item[valueField]) || 1;\n            const key = `${source}->${target}`;\n            if (linkMap.has(key)) {\n                const existingValue = linkMap.get(key);\n                linkMap.set(key, aggregateBy === 'sum' ? existingValue + value : existingValue + 1);\n            }\n            else {\n                linkMap.set(key, aggregateBy === 'sum' ? value : 1);\n            }\n        });\n        const links = Array.from(linkMap.entries()).map(([key, value]) => {\n            const [source, target] = key.split('->');\n            return { source, target, value };\n        });\n        return { nodes, links };\n    }\n    /**\n     * Create financial flow configuration\n     */\n    setFinancialFlow() {\n        return this\n            .setNodeWidth(20)\n            .setNodeGap(8)\n            .setLayout('left')\n            .setCurveness(0.5)\n            .setEmphasisFocus('adjacency')\n            .setNodeColors(['#5470c6', '#91cc75', '#fac858', '#ee6666', '#73c0de']);\n    }\n    /**\n     * Create budget allocation configuration\n     */\n    setBudgetAllocation() {\n        return this\n            .setNodeWidth(15)\n            .setNodeGap(10)\n            .setLayout('left')\n            .setCurveness(0.4)\n            .setEmphasisFocus('adjacency')\n            .setNodeColors(['#2E8B57', '#4682B4', '#DAA520', '#DC143C', '#9370DB']);\n    }\n    /**\n     * Create investment flow configuration\n     */\n    setInvestmentFlow() {\n        return this\n            .setNodeWidth(25)\n            .setNodeGap(12)\n            .setLayout('left')\n            .setCurveness(0.3)\n            .setEmphasisFocus('adjacency')\n            .setNodeColors(['#667eea', '#764ba2', '#f093fb', '#f5576c', '#4facfe']);\n    }\n    /**\n     * Set percentage display for sankey values\n     */\n    setPercentageDisplay() {\n        this.setTooltip('item', (params) => {\n            if (params.data.source) {\n                // This is a link\n                return `${params.data.source} → ${params.data.target}<br/>Value: ${params.data.value}%`;\n            }\n            else {\n                // This is a node\n                return `${params.data.name}<br/>Total: ${params.data.value || 0}%`;\n            }\n        });\n        return this;\n    }\n    /**\n     * Set currency display for sankey values\n     */\n    setCurrencyDisplay(currencyCode = 'USD', locale = 'en-US') {\n        const formatter = new Intl.NumberFormat(locale, {\n            style: 'currency',\n            currency: currencyCode,\n            minimumFractionDigits: 0,\n            maximumFractionDigits: 0\n        });\n        this.setTooltip('item', (params) => {\n            if (params.data.source) {\n                // This is a link\n                return `${params.data.source} → ${params.data.target}<br/>Amount: ${formatter.format(params.data.value)}`;\n            }\n            else {\n                // This is a node\n                return `${params.data.name}<br/>Total: ${formatter.format(params.data.value || 0)}`;\n            }\n        });\n        return this;\n    }\n    /**\n     * Create minimal test configuration for debugging\n     */\n    setMinimalConfiguration() {\n        return this\n            .setNodeWidth(10)\n            .setNodeGap(5)\n            .setLayout('none')\n            .setCurveness(0.5)\n            .setEmphasisFocus('adjacency');\n    }\n    /**\n     * Check if widget is a sankey chart\n     */\n    static isSankeyChart(widget) {\n        return widget.config?.component === 'echart' &&\n            widget.config?.options?.series?.[0]?.type === 'sankey';\n    }\n    /**\n     * Export sankey chart data for Excel/CSV export\n     */\n    static exportData(widget) {\n        const data = widget.data;\n        if (!data || !data.links)\n            return [];\n        return data.links.map(link => ({\n            'Source': link.source,\n            'Target': link.target,\n            'Value': link.value,\n        }));\n    }\n    /**\n     * Get headers for sankey chart export\n     */\n    static getExportHeaders(widget) {\n        return ['Source', 'Target', 'Value'];\n    }\n    /**\n     * Get sheet name for sankey chart export\n     */\n    static getExportSheetName(widget) {\n        const title = widget.config?.header?.title || 'Sankey Chart';\n        return title.replace(/[^a-zA-Z0-9\\s]/g, '').substring(0, 31);\n    }\n}","originalLength":10449,"removedExports":[],"renderedExports":["SankeyChartBuilder"],"renderedLength":10329},"/home/raja/code/stats-india/ui/dist/dashboard/tmp-esm2022/lib/echart-chart-builders/sankey/index.js":{"code":"","originalLength":73,"removedExports":[],"renderedExports":[],"renderedLength":0},"/home/raja/code/stats-india/ui/dist/dashboard/tmp-esm2022/lib/echart-chart-builders/candlestick/candlestick-chart-builder.js":{"code":"/**\n 